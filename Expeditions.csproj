<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Expeditions</AssemblyName>
    <RootNamespace>Expeditions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TMLPath Condition="'$(TMLPath)' == ''">$(LOCALAPPDATA)\Programs\tModLoader</TMLPath>
    <BuildOutputBase>$(TMLPath)\ModSources\$(AssemblyName)\bin</BuildOutputBase>
    <OutputPath>$(BuildOutputBase)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="tModLoader">
      <HintPath>$(TMLPath)\tModLoader.dll</HintPath>
    </Reference>
    <Reference Include="Terraria">
      <HintPath>$(TMLPath)\Terraria.dll</HintPath>
    </Reference>
    <Reference Include="ReLogic">
      <HintPath>$(TMLPath)\ReLogic.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="build.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="description.txt" Condition="Exists('description.txt')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="**\*.png" Exclude="bin\**;obj\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="**\*.wav" Exclude="bin\**;obj\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="**\*.mp3" Exclude="bin\**;obj\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="**\*.ogg" Exclude="bin\**;obj\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
